# Copy this file to .env and fill in your key.
# Default: Groq (free, no credit card) - get a key at https://console.groq.com/keys
MAHAM_CODE_API_KEY=gsk_your-key-here
MAHAM_CODE_BASE_URL=https://api.groq.com/openai/v1
MAHAM_CODE_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier) - key from https://aistudio.google.com/apikey
# MAHAM_CODE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MAHAM_CODE_MODEL=gemini-2.5-flash

# Ollama (runs on your own computer, fully free) - install from https://ollama.com,
# then run: ollama pull llama3.2
# MAHAM_CODE_API_KEY=ollama
# MAHAM_CODE_BASE_URL=http://localhost:11434/v1
# MAHAM_CODE_MODEL=llama3.2
